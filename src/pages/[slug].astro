---
import Layout from '../layouts/Layout.astro'
import Content from '@component/Content.astro'
import Header from '@component/Header.astro'
import CTA from '@component/CTA.astro'
import FAQModal from '@component/FAQModal.astro'
import Promise from '@component/Promise.astro'
import Gallery from '@component/Gallery.astro'
import Banner from '@component/Banner.astro'
import { getCollection } from 'astro:content'
import { formatEventDateLabel } from '../lib/formatEventDate'

export async function getStaticPaths() {
  const cities = await getCollection('cities')
  return cities.map(item => ({
    params: { slug: item.id },
    props: { entry: item.data },
  }))
}

const { entry } = Astro.props
const earlyBird = entry.earlyBird
const city = String(entry.cityName ?? '').trim()
const cityTitleName = city || 'Event'
const eventDateLabel = formatEventDateLabel(entry.eventDate) || 'DATE'
const ticketSaleLink =
  typeof entry.ticketSaleLink === 'string' && entry.ticketSaleLink.trim() !== '' ? entry.ticketSaleLink : '#tickets'

const locationTime = entry.locationTime
const description = `Brave a spooky ghost hunt through the streets of ${cityTitleName} in this interactive, suspense-filled multi-team event.
        Start anytime from ${locationTime}, follow eerie clues, and make choices that change your route and ending. Dress
        up, snap paranormal photos, and compete for prizes. Limited tickets available before they vanish into the night.`
const groupButtonTitle = earlyBird ? 'Regular Pass' : 'Single Ticket'
const soloButtonTitle = earlyBird ? 'Early Bird Pass' : 'Group Rates'
const earlyBirdEnds = formatEventDateLabel(entry.earlyBirdEnds)
---

<Layout title={`Alice in Wonderland · The Immersive ${cityTitleName} Event`} description={description}>
  <main class="alice-gradient min-h-screen overflow-hidden">
    <Header
      locationLabel={cityTitleName}
      eventDateLabel={eventDateLabel}
      ticketHref={ticketSaleLink}
      citySlug={Astro.params.slug}
    />
    <CTA
      groupTicketPrice={entry.groupTicketPrice}
      soloTicketPrice={entry.soloTicketPrice}
      ticketSaleLink={ticketSaleLink}
      soloTicketTitle={soloButtonTitle}
      groupTicketTitle={groupButtonTitle}
      locationLabel={cityTitleName}
      locationLabel={cityTitleName}
      eventDateLabel={eventDateLabel}
      earlyBird={earlyBird}
    />
    <div>
      <Content cityName={cityTitleName} locationTime={locationTime} earlyBird={earlyBird} />
    </div>
    <FAQModal
      locationTime={locationTime}
      eventDate={entry.eventDate}
      hasPhotographer={entry.hasPhotographer ?? true}
      locationStart={entry.locationStart}
      locationLink={entry.locationLink}
      earlyBird={earlyBird}
      earlyBirdEnds={earlyBirdEnds}
    />
    <div class="flex flex-col">
      <Gallery
        title="WHAT TO EXPECT"
        description="A city slipping into Wonderland: each location reveals strange encounters, shifting logic, curious characters, and a new breach to solve as you work with Alice to stop the Queen and save your city."
        youtubeUrl={'https://youtu.be/48XG0B4vJxU'}
      />
      <Banner link={ticketSaleLink} price={entry.soloTicketPrice} label={'Buy Tickets'} />
    </div>
    <div>
      <Promise />
    </div>
  </main>
</Layout>

<style>
  .alice-gradient {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 1) 0%, rgba(40, 4, 6, 1) 100%);
  }
</style>
