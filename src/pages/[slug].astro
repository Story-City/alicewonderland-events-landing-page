---
import Layout from '../layouts/Layout.astro'
import Content from '@component/Content.astro'
import Header from '@component/Header.astro'
import CTA from '@component/CTA.astro'
import FAQModal from '@component/FAQModal.astro'
import Promise from '@component/Promise.astro'
import Gallery from '@component/Gallery.astro'
import Banner from '@component/Banner.astro'
import { getCollection } from 'astro:content'
import { STORY_APP_URL, STORY_NAME } from '../lib/app'

export async function getStaticPaths() {
  const cities = await getCollection('cities')
  return cities.map(item => ({
    params: { slug: item.id },
    props: { entry: item.data },
  }))
}

const { entry } = Astro.props
const cityTitleName = String(entry.cityName ?? '').trim()
const description = `Wonderland is bleeding into ${cityTitleName}. Play ${STORY_NAME} on the Story City app: follow the Rabbit, find Alice, and make choices that decide your ending.`
---

<Layout title={`${STORY_NAME} · Play in ${cityTitleName} on Story City`} description={description}>
  <main class="alice-gradient min-h-screen overflow-hidden">
    <Header locationLabel={cityTitleName} appHref={STORY_APP_URL} citySlug={Astro.params.slug} />
    <CTA locationLabel={cityTitleName} hasAppRoute={entry.hasAppRoute} />
    <div>
      <Content cityName={cityTitleName} />
    </div>
    <FAQModal />
    <div class="flex flex-col">
      <Gallery
        title="WHAT TO EXPECT"
        description="A city slipping into Wonderland: each location reveals strange encounters, shifting logic, curious characters, and a new breach to solve as you work with Alice to stop the Queen and save your city."
        youtubeUrl={'https://youtu.be/48XG0B4vJxU'}
      />
      <Banner link={STORY_APP_URL} heading={`Wonderland is waiting in ${cityTitleName}`} label="Play in the app" />
    </div>
    <div>
      <Promise />
    </div>
  </main>
</Layout>

<style>
  .alice-gradient {
    background: linear-gradient(to bottom, rgba(0, 0, 0, 1) 0%, rgba(40, 4, 6, 1) 100%);
  }
</style>
