---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import YouTubeLite from '@component/YouTubeLite.astro'

export interface Props {
  title: string
  description: string
  youtubeUrl?: string
}

const { title, description, youtubeUrl } = Astro.props

const imageModules = import.meta.glob<{ default: ImageMetadata }>('./gallery/*.webp', { eager: true })
const videoModules = import.meta.glob<{ default: string }>('./gallery/*.webm', { eager: true, import: 'default' })

type Slide =
  | { kind: 'image'; src: ImageMetadata }
  | { kind: 'video'; src: string }
  | { kind: 'youtube'; videoId: string }

function extractYoutubeId(url: string): string | null {
  const m = url.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{11})/)
  return m ? m[1] : null
}

const fileSlides: Slide[] = [
  ...Object.keys(imageModules).map(globPath => ({
    kind: 'image' as const,
    src: imageModules[globPath].default,
    path: globPath,
  })),
  ...Object.keys(videoModules).map(globPath => ({
    kind: 'video' as const,
    src: videoModules[globPath] as unknown as string,
    path: globPath,
  })),
]
  .sort((a, b) => a.path.localeCompare(b.path, undefined, { numeric: true }))
  .map(({ kind, src }) => ({ kind, src }) as Slide)

const youtubeId = youtubeUrl ? extractYoutubeId(youtubeUrl) : null
const slides: Slide[] = youtubeId ? [{ kind: 'youtube', videoId: youtubeId }, ...fileSlides] : fileSlides

const galleryHeartIconPath =
  'M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z'
---

{
  slides.length > 0 && (
    <section class="gallery-section w-full bg-black text-white relative overflow-hidden" data-gallery>
      <div class="gallery-panel relative z-1 px-5 py-12 md:py-16">
        <div class="gallery-inner mt-4 max-w-3xl mx-auto flex flex-col items-center text-center">
          <h2 class="font-kyivtype text-2xl md:text-3xl uppercase mb-4 text-pretty">{title}</h2>
          <p class="font-youngest text-base md:text-lg text-white/90 max-w-xl mb-8 text-pretty leading-snug">
            {description}
          </p>

          <div class="gallery-viewport-wrapper relative w-full">
            <div class="gallery-viewport relative w-full aspect-4/3 max-h-[70vh] overflow-hidden bg-black/40">
              {slides.map((slide, i) => (
                <div
                  class:list={[
                    'gallery-slide absolute inset-0 transition-opacity duration-300',
                    i === 0 ? 'gallery-slide--active opacity-100 z-1' : 'opacity-0 z-0 pointer-events-none',
                  ]}
                  data-gallery-slide
                  aria-hidden={i === 0 ? 'false' : 'true'}
                >
                  {slide.kind === 'image' && (
                    <Image
                      src={slide.src}
                      alt={`${title} — slide ${i + 1} of ${slides.length}`}
                      class="w-full h-full object-cover"
                      width={1080}
                      height={1350}
                      sizes="(min-width: 768px) 48rem, 100vw"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                  )}
                  {slide.kind === 'video' && (
                    <video src={slide.src} class="w-full h-full object-cover" playsinline muted loop data-gallery-video>
                      <track kind="descriptions" label={`${title} — slide ${i + 1} of ${slides.length}`} />
                    </video>
                  )}
                  {slide.kind === 'youtube' && (
                    <YouTubeLite videoId={slide.videoId} title={`${title} — slide ${i + 1} of ${slides.length}`} fill />
                  )}
                </div>
              ))}
            </div>

            {slides.length > 1 && (
              <>
                <button
                  type="button"
                  class="gallery-arrow gallery-arrow--prev"
                  data-gallery-prev
                  aria-label="Previous slide"
                >
                  <svg width="32" height="18" fill="none" aria-hidden="true" viewBox="0 0 32 18">
                    <path fill="currentColor" d="M14.87 0 0 8.72l15.237 8.448 15.855-9.113z" />
                  </svg>
                </button>
                <button
                  type="button"
                  class="gallery-arrow gallery-arrow--next"
                  data-gallery-next
                  aria-label="Next slide"
                >
                  <svg width="32" height="18" fill="none" aria-hidden="true" viewBox="0 0 32 18">
                    <path fill="currentColor" d="M14.87 0 0 8.72l15.237 8.448 15.855-9.113z" />
                  </svg>
                </button>
              </>
            )}
          </div>

          <div class="gallery-dots flex flex-wrap justify-center gap-2 mt-6" role="tablist" aria-label="Gallery slides">
            {slides.map((_, i) => (
              <button
                type="button"
                class="gallery-dot inline-flex items-center justify-center p-0 border-0 transition-[color,filter] focus:outline-none"
                data-gallery-dot
                role="tab"
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={`Show slide ${i + 1} of ${slides.length}`}
                tabindex={i === 0 ? 0 : -1}
              >
                <svg class="gallery-dot-heart" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d={galleryHeartIconPath} />
                </svg>
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>
  )
}

<script is:inline>
  document.querySelectorAll('[data-gallery]').forEach(function (root) {
    var slides = root.querySelectorAll('[data-gallery-slide]')
    var dots = root.querySelectorAll('[data-gallery-dot]')
    if (!slides.length || !dots.length) return

    function syncVideos() {
      slides.forEach(function (slide) {
        var video = slide.querySelector('[data-gallery-video]')
        if (!video) return
        var active = slide.classList.contains('gallery-slide--active')
        if (active) {
          video.play().catch(function () {})
        } else {
          video.pause()
        }
      })
    }

    var current = 0

    function goTo(index) {
      current = Math.max(0, Math.min(index, slides.length - 1))
      slides.forEach(function (slide, idx) {
        var active = idx === current
        slide.classList.toggle('gallery-slide--active', active)
        slide.classList.toggle('opacity-100', active)
        slide.classList.toggle('z-1', active)
        slide.classList.toggle('opacity-0', !active)
        slide.classList.toggle('z-0', !active)
        slide.classList.toggle('pointer-events-none', !active)
        slide.setAttribute('aria-hidden', active ? 'false' : 'true')
      })
      dots.forEach(function (dot, idx) {
        var active = idx === current
        dot.setAttribute('aria-selected', active ? 'true' : 'false')
        dot.tabIndex = active ? 0 : -1
      })
      syncVideos()
    }

    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        goTo(i)
      })
    })

    var prevBtn = root.querySelector('[data-gallery-prev]')
    var nextBtn = root.querySelector('[data-gallery-next]')

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        goTo(current <= 0 ? slides.length - 1 : current - 1)
      })
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        goTo(current >= slides.length - 1 ? 0 : current + 1)
      })
    }

    // Touch swipe support for mobile
    var viewport = root.querySelector('.gallery-viewport-wrapper')
    var touchStartX = 0
    var touchStartY = 0
    var SWIPE_THRESHOLD = 50

    if (viewport) {
      viewport.addEventListener(
        'touchstart',
        function (e) {
          touchStartX = e.changedTouches[0].clientX
          touchStartY = e.changedTouches[0].clientY
        },
        { passive: true },
      )

      viewport.addEventListener(
        'touchend',
        function (e) {
          var dx = e.changedTouches[0].clientX - touchStartX
          var dy = e.changedTouches[0].clientY - touchStartY

          // Only trigger if horizontal movement exceeds vertical (avoid hijacking scroll)
          if (Math.abs(dx) > SWIPE_THRESHOLD && Math.abs(dx) > Math.abs(dy)) {
            if (dx < 0) {
              goTo(current >= slides.length - 1 ? 0 : current + 1)
            } else {
              goTo(current <= 0 ? slides.length - 1 : current - 1)
            }
          }
        },
        { passive: true },
      )
    }

    syncVideos()
  })
</script>

<style>
  /* Decorative angular shapes — desktop only */
  .gallery-shapes {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .gallery-shape--1 {
    position: absolute;
    top: 50px;
    left: 50%;
    transform: translateX(-50%);
    width: clamp(1100px, 120%, 120%);
    height: 550px;
    clip-path: polygon(20% 0, 100% 0%, 80% 100%, 0% 100%);
  }

  /* Arrow buttons */
  .gallery-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: #e62828;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .gallery-arrow:hover {
    background: #e62828;
    color: #000;
  }
  .gallery-arrow:focus-visible {
    outline: none;
    box-shadow:
      0 0 0 2px #e62828,
      0 0 0 4px #000;
  }
  .gallery-arrow--prev {
    left: 8px;
  }
  .gallery-arrow--next {
    right: 8px;
  }

  @media (min-width: 768px) {
    .gallery-arrow {
      width: 48px;
      height: 48px;
      display: flex;
    }
    .gallery-arrow--prev {
      left: -64px;
    }
    .gallery-arrow--next {
      right: -64px;
    }
  }

  /* Heart indicators (replacing dots) */
  .gallery-dot {
    background: transparent;
    border: none;
    cursor: pointer;
    color: inherit;
  }
  .gallery-dot-heart {
    display: block;
    flex-shrink: 0;
    transition: filter 0.15s ease;
  }
  .gallery-dot:focus-visible .gallery-dot-heart {
    filter: drop-shadow(0 0 2px #000) drop-shadow(0 0 6px #e62828);
  }
  .gallery-dot[aria-selected='true'] {
    color: #e62828;
  }
  .gallery-dot[aria-selected='false'] {
    color: color-mix(in srgb, #dfdfdf 55%, transparent);
  }
  .gallery-dot[aria-selected='false']:hover {
    color: #dfdfdf;
  }
</style>
