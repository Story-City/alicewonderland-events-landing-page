---
import { Image } from 'astro:assets'
import personImg from './person.webp'
import Quote from '@component/Quote.astro'

export interface Props {
  cityName?: string
  locationTime?: string
}

const { cityName, locationTime } = Astro.props
const discount = '33%'
---

<section class="w-full max-w-6xl mx-auto bg-black text-[#B0B0B0] font-youngest relative py-4">
  <div class="w-full lg:w-2/3 z-10">
    <div class="px-11 mt-5">
      <h3 class="text-2xl leading-tight font-medium mb-6">Join 30,000+ Story City Adventurers Worldwide</h3>
      <p class="text-lg lg:text-2xl leading-tight font-normal font-youngest mb-3">
        Wonderland is bleeding into {cityName}.
      </p>
      <p class="text-lg lg:text-2xl leading-tight font-normal font-youngest mb-3">
        The Queen of Hearts is expanding her territory; portals are opening, places are changing, and Alice is trapped
        on the other side. She needs your help to stop the take over!
      </p>
      <p class="text-lg lg:text-2xl leading-tight font-normal font-youngest mb-3">
        Step into a whimsical experience woven through the streets of {cityName} in this interactive, multi-team event. Track
        breaches, face curious characters, and make choices that decide the fate of your team, Alice, and your city.
      </p>
      <p class="text-lg lg:text-2xl leading-tight font-normal font-youngest mb-3">
        Start anytime from {locationTime}. Dress in your maddest attire, capture surreal moments, and compete for
        delightfully peculiar prizes.
      </p>
      <p class="text-lg lg:text-2xl leading-tight font-normal font-youngest mb-3">
        Will you seal the breaches… or let the Queen, and Wonderland, take over?
      </p>
      <p class="text-lg lg:text-2xl leading-tight font-normal font-youngest mb-3">
        Limited tickets available - get early bird pricing if you buy today!
      </p>
      <a href="#" data-faq-trigger class="text-white underline text-lg lg:text-2xl font-youngest"> More Info </a>
    </div>
    <div class="blur-bg" data-reveal="fade" style="transition-delay: 400ms;"></div>
  </div>
  <div class="min-h-[500px] flex items-start">
    <Quote />
  </div>
  <Image src={personImg} width={412} height={618} class="pointer-events-none person-img" alt="Person with flashlight" />
</section>

<style>
  .blur-bg {
    position: absolute;
    top: 0;
    left: 0;
    background: linear-gradient(180deg, rgba(51, 175, 193, 0.38) 0%, rgba(180, 244, 255, 0.38) 100%);
    filter: blur(113px);
    border-radius: 560px;
    width: 100%;
    height: 64%;
    transform: translateX(17%);
    transform-origin: center;
    pointer-events: none;
  }

  .person-img {
    height: auto;
    width: 450px;
    position: absolute;
    right: 0;
    bottom: 0;
  }
  @media (min-width: 1024px) {
    .blur-bg {
      transform: translateX(48%);
      height: 50%;
    }
    .person-img {
      width: auto;
      height: 800px;
      transform: translateX(25%);
      z-index: 1;
    }
  }
</style>
