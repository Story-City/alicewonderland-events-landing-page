---
export interface Props {
  link: string
  heading: string
  label: string
}

const { link, heading, label } = Astro.props
const linkAttrs = link.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}
---

<div class="bg-cream px-6 py-6 w-screen flex flex-col sm:flex-row gap-3 sm:gap-0 justify-center items-center -order-1 lg:order-2">
  <div class="sm:mr-4 lg:mr-14 text-balance text-center sm:text-left">
    <span class="text-xl font-kyivtype font-bold">{heading}</span>
  </div>
  <a href={link} {...linkAttrs} class="app-btn">{label}</a>
</div>

<style>
  .app-btn {
    font-family: 'KyivType Titling', sans-serif;
    font-weight: 700;
    padding: 10px 45px;
    box-sizing: border-box;
    position: relative;
    width: fit-content;
    text-decoration: none;
    margin-bottom: 0;
    margin-top: 0;
    color: var(--color-white);
    border-bottom-left-radius: 999px;
    border-top-right-radius: 999px;
    background: var(--color-sky);
    font-size: 18px;
    white-space: nowrap;
  }
</style>
