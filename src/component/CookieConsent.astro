<div id="cookie-consent" class="hidden fixed bottom-0 left-0 right-0 z-50 font-youngest">
  <div class="bg-black/95 border-t border-[#0F7D89]/40 px-5 py-4">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center gap-4">
      <p class="text-[#B0B0B0] text-sm flex-1 text-center sm:text-left">
        We use cookies and tracking technologies to improve your experience and analyze site traffic.
      </p>
      <button
        id="cookie-accept"
        class="buy-tickets-btn font-kyivtype cursor-pointer border-none bg-transparent shrink-0"
      >
        <span class="buy-tickets-btn__text">GOT IT</span>
      </button>
    </div>
  </div>
</div>

<style>
  .buy-tickets-btn {
    padding: 10px 40px;
    box-sizing: border-box;
    position: relative;
    width: fit-content;
    color: #fff;
    border-bottom-left-radius: 999px;
    border-top-right-radius: 999px;
    font-weight: 700;
    letter-spacing: -0.05em;
    background: #63b0e4;
  }
</style>

<script>
  const banner = document.getElementById('cookie-consent')!
  const stored = localStorage.getItem('cookie-consent')

  if (!stored) {
    banner.classList.remove('hidden')
  }

  document.getElementById('cookie-accept')!.addEventListener('click', () => {
    localStorage.setItem('cookie-consent', 'accepted')
    banner.classList.add('hidden')
    const gtagFn = (window as unknown as { gtag?: (...args: any[]) => void }).gtag
    if (typeof gtagFn === 'function') {
      gtagFn('consent', 'update', {
        analytics_storage: 'granted',
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted',
      })
    }
  })
</script>
