---
import Rating from './Rating.astro'

interface Props {
  comment: string
  rating: number
  author: string
}

const { comment, rating, author } = Astro.props
---

<div class="rounded-lg p-6 h-full flex flex-col items-center">
  <div class="mb-3"><Rating rating={rating} width={28} height={28} /></div>
  <p class="text-zinc-300 text-center text-2xl leading-relaxed mb-4 font-kyivtype">
    <span data-text={`"${comment}"`}>"{comment}"</span>
  </p>
  <p class="text-white font-bold text-xl font-youngest">— {author}</p>
</div>
