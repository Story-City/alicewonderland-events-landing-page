---
import Rating from '@component/Rating.astro'
const quote =
  'Wonderland taking over the city was not what we expected, in the best way. We were racing between locations, making wild choices, and somehow actually saved Alice. Completely chaotic, completely magical.'
const author = 'Jasmine Y.'
---

<div class="w-full mt-12">
  <div class="quote py-10 relative z-1 bg-[#FFF3DD] rounded-xl">
    <div class="flex">
      <div class="text-xl w-1/2 lg:w-2/3 max-w-[600px] px-11 relative z-10">
        <p class="font-youngest text-[#13123B] lg:text-2xl leading-tight tracking-wide uppercase">"{quote}"</p>
        <div class="flex items-center gap-4 mt-4">
          <span class="font-youngest text-[#AC3E3E] lg:text-2xl leading-tight">-{author}</span>
          <Rating rating={5} />
        </div>
      </div>
    </div>
  </div>
</div>
