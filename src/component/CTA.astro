---
export interface Props {
  groupTicketPrice?: string
  soloTicketPrice?: string
  ticketSaleLink?: string
  soloTicketLink?: string
  soloTicketTitle?: string
  soloButtonLabel?: string
  groupTicketTitle?: string
  groupButtonLabel?: string
  bundleCopy?: string
  locationLabel?: string
}

const {
  groupTicketPrice = '$37.50',
  soloTicketPrice = '$30',
  ticketSaleLink = '#tickets',
  soloTicketLink,
  soloTicketTitle = 'Lone Hunter',
  soloButtonLabel = 'Buy Ticket',
  groupTicketTitle = 'Team Pass',
  groupButtonLabel = 'Buy Tickets',
  bundleCopy,
} = Astro.props

const groupLink = ticketSaleLink
const soloLink = soloTicketLink && soloTicketLink.trim() !== '' ? soloTicketLink : ticketSaleLink

const groupAttrs = groupLink.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}
const soloAttrs = soloLink.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}
---

<div class="w-full max-w-6xl mx-auto text-[#010912] font-kyivtype">
  <div class="bg-[#FFF3DD] pr-4 max-w-[500px] ml-auto py-6 cta-wrapper lg:hidden flex">
    <div class="cta-content flex flex-col">
      <div>
        <div class="text-2xl leading-tight text-balance pl-16">
          <span data-text={soloTicketTitle}>{soloTicketTitle}</span>
        </div>
        <div class="flex items-center pl-22">
          <span class="text-[32px] leading-tight">{soloTicketPrice}</span>
        </div>
      </div>

      <a href={soloLink} class="ml-24 buy-tickets-btn block" {...soloAttrs}>
        <span class="buy-tickets-btn__fill bg-[#3CE0F2]" aria-hidden="true"></span>
        <span class="buy-tickets-btn__text">{soloButtonLabel}</span>
      </a>
    </div>
  </div>

  <div class="bg-[#FFF3DD] pr-4 max-w-[500px] ml-auto mt-6 py-6 cta-wrapper lg:hidden flex">
    <div class="cta-content flex flex-col">
      <div>
        <div class="text-2xl leading-tight text-balance pl-16">
          <span data-text={groupTicketTitle}>{groupTicketTitle}</span>
        </div>
        <div class="flex items-center pl-22">
          <span class="text-[32px] leading-tight">{groupTicketPrice}</span>
        </div>
        {bundleCopy && <div class="pl-22 pr-2 text-base text-[#010912] font-youngest mt-1">{bundleCopy}</div>}
      </div>

      <a href={groupLink} class="ml-24 buy-tickets-btn block" {...groupAttrs}>
        {groupButtonLabel}
      </a>
    </div>
  </div>

  <div class="hidden lg:grid grid-cols-2 max-w-[1100px] ml-auto gap-6 pr-8">
    <div class="min-w-0 relative py-6 desktop-cta-card rounded-xl desktop-cta-card--solo overflow-hidden">
      <div class="desktop-cta-card-clip bg-[#FFF3DD] absolute inset-0"></div>
      <div class="desktop-cta-content relative flex items-center h-full px-10">
        <div class="text-center mr-6">
          <div class="text-2xl leading-tight w-max">
            <span data-text={soloTicketTitle}>{soloTicketTitle}</span>
          </div>
          <div class="text-[32px] leading-tight">{soloTicketPrice}</div>
        </div>

        <a href={soloLink} class="buy-tickets-btn block w-max" {...soloAttrs}>
          {soloButtonLabel}
        </a>
      </div>
    </div>

    <div class="min-w-0 relative py-6 desktop-cta-card rounded-xl desktop-cta-card--group overflow-hidden">
      <div class="desktop-cta-card-clip bg-[#FFF3DD] absolute inset-0"></div>
      <div class="desktop-cta-content relative flex items-center h-full px-10">
        <div class="text-center mr-6">
          <div class="text-2xl leading-tight w-max">
            <span data-text={groupTicketTitle}>{groupTicketTitle}</span>
          </div>
          <div class="text-[32px] leading-tight">{groupTicketPrice}</div>
          {bundleCopy && <div class="text-sm text-[#010912] font-youngest mt-1 w-max">{bundleCopy}</div>}
        </div>

        <a href={groupLink} class="buy-tickets-btn block w-max" {...groupAttrs}>
          {groupButtonLabel}
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .buy-tickets-btn {
    padding: 13px 40px;
    box-sizing: border-box;
    position: relative;
    width: fit-content;
    text-decoration: none;
    margin-top: 12px;
    color: #fff;
    border-bottom-left-radius: 999px;
    border-top-right-radius: 999px;
    font-weight: 700;
    letter-spacing: -0.05em;
    background: #63b0e4;
    font-size: 18px;
  }

  @media (min-width: 1024px) {
    .buy-tickets-btn {
      margin-top: 0px;
      padding: 18px 50px;
      width: max-content;
    }
  }
</style>
