---
import { STORY_APP_URL, STORY_NAME } from '@/lib/app'

export interface Props {
  locationLabel?: string
}

const { locationLabel = '' } = Astro.props
---

<div class="w-full text-ink font-kyivtype py-24 checkerboard-bg">
  <div class="max-w-6xl mx-auto px-5">
    <div class="text-white flex lg:hidden flex-col items-center justify-center">
      {locationLabel && <div class="text-2xl font-kyivtype leading-tight">{locationLabel}</div>}
      <h2 class="text-2xl font-youngest text-center text-pretty">Follow the Rabbit. Find Alice. Save your City.</h2>
    </div>
    <div class="bg-cream mt-6 mx-auto max-w-3xl px-6 lg:px-12 py-8 rounded-xl flex flex-col items-center text-center gap-4">
      <h2 class="text-2xl lg:text-3xl leading-tight font-bold font-kyivtype text-balance">
        {STORY_NAME} is on the Story City app
      </h2>
      <p class="text-lg lg:text-xl font-youngest text-balance">
        The {locationLabel} route is live in the app. Play it at your own pace.
      </p>
      <a href={STORY_APP_URL} class="app-btn" target="_blank" rel="noopener noreferrer">Play in the app</a>
    </div>
  </div>
</div>

<style>
  .app-btn {
    padding: 18px 50px;
    box-sizing: border-box;
    width: fit-content;
    text-decoration: none;
    color: var(--color-white);
    border-bottom-left-radius: 999px;
    border-top-right-radius: 999px;
    font-weight: 700;
    letter-spacing: 1px;
    background: var(--color-sky);
    font-size: 18px;
    display: inline-block;
  }

  .checkerboard-bg {
    background:
      linear-gradient(rgba(0, 0, 0, 1) 5%, rgba(0, 0, 0, 0.7) 50%, rgba(0, 0, 0, 1) 95%), url('/checker.webp');
    background-size: 800px;
    background-repeat: repeat;
  }
</style>
