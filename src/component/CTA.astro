---
export interface Props {
  groupTicketPrice?: string
  soloTicketPrice?: string
  ticketSaleLink?: string
  soloTicketLink?: string
  soloTicketTitle?: string
  soloButtonLabel?: string
  groupTicketTitle?: string
  groupButtonLabel?: string
  bundleCopy?: string
  locationLabel?: string
  eventDateLabel?: string
}

const {
  groupTicketPrice = '$37.50',
  soloTicketPrice = '$30',
  ticketSaleLink = '#tickets',
  soloTicketLink,
  soloTicketTitle = 'Lone Hunter',
  soloButtonLabel = 'Buy Ticket',
  groupTicketTitle = 'Team Pass',
  groupButtonLabel = 'Buy Tickets',
  locationLabel = '',
  eventDateLabel = '',
  bundleCopy,
} = Astro.props

const groupLink = ticketSaleLink
const soloLink = soloTicketLink && soloTicketLink.trim() !== '' ? soloTicketLink : ticketSaleLink

const groupAttrs = groupLink.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}
const soloAttrs = soloLink.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {}
---

<div class="w-full text-[#010912] font-kyivtype py-16 checkerboard-bg">
  <div class="max-w-6xl mx-auto flex flex-col lg:items-center lg:flex-row gap-10">
    <div class="text-white flex lg:hidden flex-col lg:flex-row items-center justify-center lg:justify-between">
      {
        locationLabel && eventDateLabel && (
          <div class="text-2xl font-kyivtype leading-tight flex items-center">
            <span>{locationLabel}</span>
            <span class="mx-3">/</span>
            <span>{eventDateLabel}</span>
          </div>
        )
      }

      <h2 class="text-2xl font-youngest text-center lg:text-left text-pretty">
        Follow the Rabbit. Find Alice. Save your City.
      </h2>
    </div>
    <div class="bg-[#FFF3DD] px-12 w-[450px] lg:w-[550px] py-6 flex rounded-xl">
      <div class="cta-content flex flex-col items-center lg:flex-row w-full">
        <div class="px-6 text-center">
          <div class="text-2xl leading-tight font-bold text-balance">
            <span data-text={soloTicketTitle}>{soloTicketTitle}</span>
          </div>
          <div class="">
            <span class="text-[32px] leading-tight font-bold">{soloTicketPrice}</span>
          </div>
        </div>
        <div class="flex flex-col">
          <a href={soloLink} class="buy-tickets-btn" {...soloAttrs}>
            {soloButtonLabel}
          </a>
          <div class="h-6"></div>
        </div>
      </div>
    </div>
    <div class="bg-[#FFF3DD] ml-auto lg:ml-0 px-12 w-[450px] lg:w-[550px] py-6 flex rounded-xl">
      <div class="cta-content flex flex-col items-center lg:flex-row w-full">
        <div class="px-6 text-center">
          <div class="text-2xl leading-tight font-bold text-balance">
            <span>{groupTicketTitle}</span>
          </div>
          <div class="">
            <span class="text-[32px] leading-tight font-bold">{groupTicketPrice}</span>
          </div>
        </div>
        <div class="flex flex-col">
          <a href={groupLink} class="ml-6 buy-tickets-btn" {...groupAttrs}>
            {groupButtonLabel}
          </a>

          {bundleCopy && <div class="text-sm text-[#010912] uppercase font-youngest mt-2">{bundleCopy}</div>}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .buy-tickets-btn {
    padding: 18px 50px;
    box-sizing: border-box;
    position: relative;
    width: fit-content;
    text-decoration: none;
    margin-top: 12px;
    color: #fff;
    border-bottom-left-radius: 999px;
    border-top-right-radius: 999px;
    font-weight: 700;
    letter-spacing: 1px;
    background: #63b0e4;
    font-size: 18px;
    display: inline-block;
  }

  @media (min-width: 1024px) {
    .buy-tickets-btn {
      margin-top: 0px;
      padding: 18px 50px;
      width: max-content;
    }
  }

  .checkerboard-bg {
    background:
      linear-gradient(rgba(0, 0, 0, 1) 10%, rgba(0, 0, 0, 0.7) 50%, rgba(0, 0, 0, 1) 90%), url('/checker.webp');
    background-size: 800px;
    background-repeat: repeat;
  }
</style>
