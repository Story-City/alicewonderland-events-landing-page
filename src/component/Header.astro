---
export interface Props {
  locationLabel?: string
  eventDateLabel?: string
  ticketHref?: string
  citySlug: string
  heroFaded?: boolean
}

import logo from './logo.png'

const { locationLabel = '', eventDateLabel = '', ticketHref = '', citySlug = '', heroFaded = false } = Astro.props

const ticketLinkAttrs = ticketHref.startsWith('http') ? ({ target: '_blank', rel: 'noopener noreferrer' } as const) : {}
const reviewsHref = `/${citySlug}/reviews`
const homeHref = `/${citySlug}`
---

<nav id="top-nav" class="fixed top-0 left-0 right-0 z-60 transition-colors duration-300 font-kyivtype">
  <div class="max-w-6xl w-full mx-auto flex justify-between items-center px-5 py-2">
    <button
      id="hamburger-btn"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      class="hamburger min-[700px]:hidden text-white p-2 -ml-2 cursor-pointer bg-transparent border-none"
    >
      <span class="hamburger__bar" aria-hidden="true"></span>
      <span class="hamburger__bar" aria-hidden="true"></span>
      <span class="hamburger__bar" aria-hidden="true"></span>
    </button>
    <a href={homeHref} class="hidden min-[700px]:block font-kyivtype"
      ><img src={logo.src} alt="Alice in Wonderland" class="w-auto h-12" />
    </a>
    <div class="flex items-center">
      <a
        href={reviewsHref}
        class:list={['hidden min-[700px]:inline text-base self-center mr-6 font-kyivtype font-bold header-links']}
        >REVIEWS</a
      >
      <a
        href="#"
        data-faq-trigger
        class:list={['hidden min-[700px]:inline text-base self-center mr-6 font-kyivtype font-bold header-links']}
        >MORE INFO</a
      >
      {
        ticketHref && (
          <a href={ticketHref} class="buy-tickets-btn block" {...ticketLinkAttrs}>
            BUY TICKETS
          </a>
        )
      }
    </div>
  </div>
</nav>

<div id="mobile-menu" class="mobile-menu fixed inset-0 z-50 bg-black/95 font-kyivtype" aria-hidden="true">
  <nav class="flex flex-col items-center gap-8 pt-28">
    <a href={homeHref} class="text-white text-3xl font-kyivtype">
      <img src={logo.src} alt="Alice in Wonderland" class="w-auto h-12" />
    </a>
    <a href={reviewsHref} class="text-white text-2xl font-kyivtype">REVIEWS</a>
    <a href="#" data-faq-trigger class="text-white text-2xl font-kyivtype">MORE INFO</a>
  </nav>
</div>

<div
  class:list={[
    'hero-outer w-full min-h-[780px] lg:min-h-[850px] text-white font-kyivtype bg-black relative overflow-hidden isolate',
    heroFaded && 'hero-outer--faded',
  ]}
>
  <div
    class="hero-content flex flex-col w-full min-h-[780px] lg:min-h-[850px] relative pb-6 px-5 max-w-[1400px] mx-auto"
  >
    <div class="max-w-6xl w-full mx-auto grow flex flex-col relative z-10">
      <div class="h-16"></div>

      <div class="w-full h-full mt-auto lg:mb-18">
        <img src={logo.src} alt="Alice in Wonderland" class="w-auto h-26" />
        <div class="flex flex-col lg:flex-row items-center justify-center lg:justify-between">
          {
            locationLabel && eventDateLabel && (
              <div class="text-2xl font-kyivtype leading-tight flex items-center">
                <span>{locationLabel}</span>
                <span class="mx-3">/</span>
                <span>{eventDateLabel}</span>
              </div>
            )
          }

          <h2
            class="text-2xl font-youngest text-center lg:text-left text-pretty"
            data-reveal="fade"
            style="transition-delay: 250ms;"
          >
            Follow the Rabbit. Find Alice. Save your City.
          </h2>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-outer--faded .hero-content {
    opacity: 0.05;
  }

  /* Hamburger → X */
  .hamburger {
    position: relative;
    width: 32px;
    height: 32px;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .hamburger__bar {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transform-origin: center;
  }
  .hamburger.is-open .hamburger__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger.is-open .hamburger__bar:nth-child(2) {
    opacity: 0;
  }
  .hamburger.is-open .hamburger__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  @media (min-width: 700px) {
    .hamburger {
      display: none;
    }
  }

  /* Mobile menu fade */
  .mobile-menu {
    opacity: 0;
    visibility: hidden;
  }
  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
  }

  .hero-content {
    background-blend-mode: darken;
    background:
      linear-gradient(
        1.12deg,
        rgba(255, 255, 255, 0) -66.42%,
        #b01120 -48.08%,
        #b51724 -30.27%,
        #2c0002 1.71%,
        rgba(122, 76, 71, 0.587836) 10.08%,
        rgba(233, 184, 168, 0) 22.01%
      ),
      url('/bg.webp');
    background-size: cover;
    background-repeat: no-repeat;
    background-position-x: 50%;
  }

  .buy-tickets-btn {
    padding: 10px 45px;
    box-sizing: border-box;
    position: relative;
    width: fit-content;
    text-decoration: none;
    margin-bottom: 0;
    margin-top: 0;
    color: #fff;
    border-bottom-left-radius: 999px;
    border-top-right-radius: 999px;
    font-weight: 700;
    letter-spacing: -0.05em;
    background: #63b0e4;
    font-size: 18px;
  }

  @media (min-width: 1024px) {
    .buy-tickets-btn {
      margin-bottom: 24px;
      margin-top: 16px;
    }
  }

  .header-links {
    color: #000;
  }
  .header-links:hover {
    color: #fff;
  }
  .header-links-active .header-links {
    color: #fff;
  }
</style>

<script>
  const nav = document.getElementById('top-nav')
  if (nav) {
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY > 50) {
          nav.style.backgroundColor = 'rgba(1, 9, 18, 0.85)'
          nav.classList.add('header-links-active')
        } else {
          nav.style.backgroundColor = 'transparent'
          nav.classList.remove('header-links-active')
        }
      },
      { passive: true },
    )
  }

  const menu = document.getElementById('mobile-menu')
  const hamburger = document.getElementById('hamburger-btn')
  const closeMenu = () => {
    menu?.classList.remove('is-open')
    menu?.setAttribute('aria-hidden', 'true')
    hamburger?.setAttribute('aria-expanded', 'false')
    hamburger?.classList.remove('is-open')
    document.body.style.overflow = ''
  }
  const openMenu = () => {
    menu?.classList.add('is-open')
    menu?.setAttribute('aria-hidden', 'false')
    hamburger?.setAttribute('aria-expanded', 'true')
    hamburger?.classList.add('is-open')
    document.body.style.overflow = 'hidden'
  }
  hamburger?.addEventListener('click', () => {
    if (hamburger.classList.contains('is-open')) closeMenu()
    else openMenu()
  })
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu))
</script>
