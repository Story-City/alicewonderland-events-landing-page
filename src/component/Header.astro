---
export interface Props {
  locationLabel?: string
  eventDateLabel?: string
  ticketHref?: string
  citySlug?: string
  heroFaded?: boolean
}

import logo from './logo.png'

const { locationLabel = '', eventDateLabel = '', ticketHref = '', citySlug = '', heroFaded = false } = Astro.props

const ticketLinkAttrs = ticketHref.startsWith('http') ? ({ target: '_blank', rel: 'noopener noreferrer' } as const) : {}
const reviewsHref = citySlug ? `/${citySlug}/reviews` : '/reviews'
const homeHref = citySlug ? `/${citySlug}` : '/'
---

<nav id="top-nav" class="fixed top-0 left-0 right-0 z-60 transition-colors duration-300 font-kyivtype">
  <div class="max-w-6xl w-full mx-auto flex justify-between items-center px-5 py-2">
    <button
      id="hamburger-btn"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      class="hamburger min-[700px]:hidden text-white p-2 -ml-2 cursor-pointer bg-transparent border-none"
    >
      <span class="hamburger__bar" aria-hidden="true"></span>
      <span class="hamburger__bar" aria-hidden="true"></span>
      <span class="hamburger__bar" aria-hidden="true"></span>
    </button>
    <a href={homeHref} class="hidden min-[700px]:block text-white text-lg lg:text-xl font-kyivtype"
      ><img src={logo.src} alt="Alice in Wonderland" class="w-auto h-12" />
    </a>
    <div class="flex items-center">
      <a href={reviewsHref} class="hidden min-[700px]:inline text-white text-base self-center mr-6 font-kyivtype"
        >REVIEWS</a
      >
      <a href="#" data-faq-trigger class="hidden min-[700px]:inline text-white text-base self-center mr-6 font-kyivtype"
        >MORE INFO</a
      >
      {
        ticketHref && (
          <a href={ticketHref} class="buy-tickets-btn block" {...ticketLinkAttrs}>
            <span class="buy-tickets-btn__fill bg-[#3CE0F2]" aria-hidden="true" />
            <span class="buy-tickets-btn__text">BUY TICKETS</span>
          </a>
        )
      }
    </div>
  </div>
</nav>

<div id="mobile-menu" class="mobile-menu fixed inset-0 z-50 bg-black/95 font-kyivtype" aria-hidden="true">
  <nav class="flex flex-col items-center gap-8 pt-28">
    <a href={homeHref} class="text-white text-3xl font-kyivtype"
      ><img src={logo.src} alt="Alice in Wonderland" class="w-auto h-12" /></a
    >
    <a href={reviewsHref} class="text-white text-2xl font-kyivtype">REVIEWS</a>
    <a href="#" data-faq-trigger class="text-white text-2xl font-kyivtype">MORE INFO</a>
  </nav>
</div>

<div
  class:list={[
    'hero-outer w-full min-h-[780px] lg:min-h-[850px] text-white font-kyivtype bg-black relative overflow-hidden isolate',
    heroFaded && 'hero-outer--faded',
  ]}
>
  <div
    class="hero-content flex flex-col w-full min-h-[780px] lg:min-h-[850px] relative pb-6 px-5 max-w-[1400px] mx-auto"
  >
    <div class="hero-static" aria-hidden="true">
      {Array.from({ length: 12 }).map(() => <div class="hero-glitch-line" />)}
    </div>
    <div class="hero-edges" aria-hidden="true">
      {Array.from({ length: 6 }).map(() => <div class="hero-glitch-vline" />)}
    </div>
    <div class="max-w-6xl w-full mx-auto grow flex flex-col relative z-10">
      <div class="h-16"></div>

      <div class="w-full h-full mt-auto lg:mb-18">
        <img src={logo.src} alt="Alice in Wonderland" class="w-auto h-12" />
        <div class="flex flex-col lg:flex-row items-center justify-center lg:justify-between">
          {
            locationLabel && eventDateLabel && (
              <div
                class="text-2xl font-kyivtype lg:ml-6 leading-tight flex items-center"
                data-reveal="fade"
                style="transition-delay: 150ms;"
              >
                <span>{locationLabel}</span>
                <span class="mx-3">/</span>
                <span>{eventDateLabel}</span>
              </div>
            )
          }

          <h2
            class="text-2xl font-youngest text-center lg:text-left text-pretty"
            data-reveal="fade"
            style="transition-delay: 250ms;"
          >
            Hunt ghosts. Survive hauntings. Save your city.
          </h2>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .hero-outer--faded .hero-content {
    opacity: 0.05;
  }

  /* Hamburger → X */
  .hamburger {
    position: relative;
    width: 32px;
    height: 32px;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .hamburger__bar {
    display: block;
    width: 22px;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
    transform-origin: center;
  }
  .hamburger.is-open .hamburger__bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .hamburger.is-open .hamburger__bar:nth-child(2) {
    opacity: 0;
  }
  .hamburger.is-open .hamburger__bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
  @media (min-width: 700px) {
    .hamburger {
      display: none;
    }
  }

  /* Mobile menu fade */
  .mobile-menu {
    opacity: 0;
    visibility: hidden;
  }
  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
  }

  /* TV static overlay on hero image (faded edges inherit TV shape) */
  .hero-static {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    mix-blend-mode: hard-light;
    opacity: 0.4;
    mask-image: radial-gradient(ellipse 70% 55% at 50% 55%, black 10%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 70% 55% at 50% 55%, black 10%, transparent 85%);
    overflow: hidden;
  }
  .hero-static__noise {
    position: absolute;
    top: -10%;
    left: -10%;
    width: 120%;
    height: 120%;
  }

  /* Horizontal interference bar sweeping down every few seconds */
  .hero-static::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 18%;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(255, 255, 255, 0.05) 40%,
      rgba(255, 255, 255, 0.12) 50%,
      rgba(255, 255, 255, 0.05) 60%,
      transparent 100%
    );
    mix-blend-mode: overlay;
  }

  .hero-content.glitching {
  }

  .hero-glitch-line {
    position: absolute;
    left: 0;
    right: 0;
    height: var(--line-h, 2px);
    top: var(--line-y, 50%);
    background: var(--line-bg, #3CE0F2);
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }
  .hero-glitch-line.fire {
  }

  .hero-edges {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent 0%, black 18%, black 96%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 18%, black 96%, transparent 100%);
  }

  .hero-glitch-vline {
    position: absolute;
    top: var(--vline-top, 0);
    bottom: var(--vline-bottom, 0);
    width: var(--vline-w, 2px);
    left: var(--vline-left, auto);
    right: var(--vline-right, auto);
    background: var(--vline-bg, #3CE0F2);
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }
  .hero-glitch-vline.fire {
  }

  .hero-content {
    background-blend-mode: darken;
    background:
      linear-gradient(
        356.33deg,
        rgba(255, 255, 255, 0) -29.82%,
        rgba(73, 75, 77, 0.714286) -19.96%,
        #000306 -10.39%,
        #000e1c 13.72%,
        #264d58 20.8%,
        rgba(0, 54, 108, 0) 28.76%
      ),
      linear-gradient(140.69deg, rgba(0, 0, 0, 0.58) 9.83%, rgba(0, 0, 0, 0) 30.13%), url('/bg.webp');
    background-size: cover;
    background-repeat: no-repeat;
    background-position-y: 10px;
    background-position-x: 59%;
    mask-image: linear-gradient(to right, transparent, black 3%, black 97%, transparent);
  }

  .hero-content::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 0;
    right: 0;
    height: 20%;
    background: linear-gradient(to top, transparent, #010912);
    pointer-events: none;
    z-index: 1;
  }

  .hero-content::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 30px;
    background: linear-gradient(to bottom, transparent, #010912);
    pointer-events: none;
  }

  .headline-bg {
    background: linear-gradient(180deg, #33afc1 0%, #b4f4ff 100%);
    filter: blur(16px);
    border-radius: 560px;
    opacity: 0.31;
    width: 100%;
    height: 100%;
  }

  .buy-tickets-btn {
    padding: 10px 45px;
    box-sizing: border-box;
    position: relative;
    width: fit-content;
    text-decoration: none;
    margin-bottom: 0;
    margin-top: 0;
  }

  @media (min-width: 1024px) {
    .buy-tickets-btn {
      margin-bottom: 24px;
      margin-top: 16px;
    }
  }

  .buy-tickets-btn__fill {
    position: absolute;
    inset: 2px;
    clip-path: polygon(0 0, 90% 0, 100% 100%, 10% 100%);
    z-index: 0;
  }

  .buy-tickets-btn__text {
    position: relative;
    z-index: 1;
    display: inline-block;
    color: #000;
    font-size: 16px;
    line-height: 1.2;
    text-transform: uppercase;
    width: max-content;
  }
</style>

<script>
  const nav = document.getElementById('top-nav')
  if (nav) {
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY > 50) {
          nav.style.backgroundColor = 'rgba(1, 9, 18, 0.85)'
        } else {
          nav.style.backgroundColor = 'transparent'
        }
      },
      { passive: true },
    )
  }

  const menu = document.getElementById('mobile-menu')
  const hamburger = document.getElementById('hamburger-btn')
  const closeMenu = () => {
    menu?.classList.remove('is-open')
    menu?.setAttribute('aria-hidden', 'true')
    hamburger?.setAttribute('aria-expanded', 'false')
    hamburger?.classList.remove('is-open')
    document.body.style.overflow = ''
  }
  const openMenu = () => {
    menu?.classList.add('is-open')
    menu?.setAttribute('aria-hidden', 'false')
    hamburger?.setAttribute('aria-expanded', 'true')
    hamburger?.classList.add('is-open')
    document.body.style.overflow = 'hidden'
  }
  hamburger?.addEventListener('click', () => {
    if (hamburger.classList.contains('is-open')) closeMenu()
    else openMenu()
  })
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu))
</script>
